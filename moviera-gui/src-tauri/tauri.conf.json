{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MOVIE-RAJA",
  "version": "0.1.0",
  "identifier": "com.moviera.gui",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MOVIE-RAJA — MovieBox GUI",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": ["icons/icon.png"],
    "category": "Multimedia",
    "shortDescription": "GUI client for the MovieBox-TUI streaming backend",
    "longDescription": "MOVIE-RAJA is a React GUI for the MovieBox-TUI Rust backend. All content, playback, downloads, Live TV and addons are served by the local MovieBox-TUI core via the moviera-adapter."
  }
}
